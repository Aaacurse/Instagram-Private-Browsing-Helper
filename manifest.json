
{
  "manifest_version": 3,
  "name": "Instagram Private Browsing Helper",
  "version": "1.0",
  "description": "Custom Instagram page helper",
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": ["content.js","new_post.js","posts_redirect.js"],
      "run_at": "document_idle"
    }
  ]
}
